{
  "name": "universal-backend-testing-framework",
  "version": "1.0.0",
  "description": "A reusable backend testing framework",
  "files": [
    "index.js",
    "src/",
    "README.md"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    }
  },
  "scripts": {
    "test": "vitest run --config config/vitest/vitest.config.js",
    "test:integration": "vitest run --config config/vitest/vitest.integration.config.js",
    "test:graphql": "vitest run --config config/vitest/vitest.graphql.integration.config.js",
    "test:rick-and-morty": "vitest run --config config/vitest/vitest.rick-and-morty.integration.config.js",
    "endpoint-tester": "node src/endpoint-tester/server.js",
    "test:errors": "vitest run --config config/vitest/vitest.config.js tests/unit/error-scenarios.test.js",
    "test:watch": "vitest --config config/vitest/vitest.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "graphql": "^16.15.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
